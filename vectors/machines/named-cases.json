{
  "family": "machines",
  "spec": "DESIGN.md — installations, the machine seam, save locations",
  "description": "Whole fixture machines (files, symlinks, core answers) in; detected installations (kind, root, health) and — when a query is present — the resolved SavePlacement out. Layout facts are sourced from RetroArch runloop.c/configuration.c/config.def.h and the shipped RetroDECK/EmuDeck configs; see docs/research/retrodeck-save-placement.md.",
  "vectors": [
    {
      "name": "retrodeck-sort-by-content-concrete",
      "rationale": "RetroDECK stock layout: cfg sets savefile_directory and sort-by-content. With a content path given, the placement is concrete: saves/<parent-dir-name>/. The existing save is observed, not guessed.",
      "input": {
        "home": "/home/deck",
        "files": {
          "/home/deck/.var/app/net.retrodeck.retrodeck/config/retrodeck/retrodeck.json": "{\"paths\": {\"rd_home_path\": \"/mnt/sd/retrodeck\", \"saves_path\": \"/mnt/sd/retrodeck/saves\"}}",
          "/home/deck/.var/app/net.retrodeck.retrodeck/config/retroarch/retroarch.cfg": "savefile_directory = \"/mnt/sd/retrodeck/saves\"\nsavefiles_in_content_dir = \"false\"\nsort_savefiles_by_content_enable = \"true\"\nsort_savefiles_enable = \"false\"\n",
          "/mnt/sd/retrodeck/roms/gba/Golden Sun (USA).zip": "",
          "/mnt/sd/retrodeck/saves/gba/Golden Sun (USA).srm": "sram"
        },
        "query": {
          "content_path": "/mnt/sd/retrodeck/roms/gba/Golden Sun (USA).zip"
        }
      },
      "expected": {
        "installations": [
          {
            "kind": "retrodeck",
            "root": "/mnt/sd/retrodeck",
            "health": "ok"
          }
        ],
        "save_location": {
          "dir": "/mnt/sd/retrodeck/saves/gba",
          "root_kind": "savefile_directory",
          "needs": [],
          "file_set": {
            "state": "observed",
            "files": [
              "Golden Sun (USA).srm"
            ]
          }
        }
      }
    },
    {
      "name": "retrodeck-multi-disc-m3u-folder",
      "rationale": "The multi-disc convention: the ROM's parent directory is named '<title>.m3u'. content_dir is the parent directory name (runloop.c:8781), so the save lands under saves/<title>.m3u/ — observed on a real installation.",
      "input": {
        "home": "/home/deck",
        "files": {
          "/home/deck/.var/app/net.retrodeck.retrodeck/config/retrodeck/retrodeck.json": "{\"paths\": {\"rd_home_path\": \"/mnt/sd/retrodeck\", \"saves_path\": \"/mnt/sd/retrodeck/saves\"}}",
          "/home/deck/.var/app/net.retrodeck.retrodeck/config/retroarch/retroarch.cfg": "savefile_directory = \"/mnt/sd/retrodeck/saves\"\nsort_savefiles_by_content_enable = \"true\"\n",
          "/mnt/sd/retrodeck/roms/psx/Final Fantasy VII (USA).m3u/Final Fantasy VII (USA).m3u": "Disc 1.cue\n",
          "/mnt/sd/retrodeck/saves/Final Fantasy VII (USA).m3u/Final Fantasy VII (USA).srm": "sram"
        },
        "query": {
          "content_path": "/mnt/sd/retrodeck/roms/psx/Final Fantasy VII (USA).m3u/Final Fantasy VII (USA).m3u"
