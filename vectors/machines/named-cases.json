    {
      "name": "retrodeck-core-override-flips-sort",
      "rationale": "RetroDECK ships config/PPSSPP/PPSSPP.cfg with sort_savefiles_by_content_enable=false — a stock installation where the core override flips the layout flat for PPSSPP-libretro. The override directory is keyed by library_name (PPSSPP), resolved live from the core binary.",
      "input": {
        "home": "/home/deck",
        "files": {
