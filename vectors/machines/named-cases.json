      },
      "expected": {
        "installations": [
          {
            "kind": "retrodeck",
            "root": "/mnt/sd/retrodeck",
            "health": "ok"
          }
        ],
        "save_location": {
          "dir": "/mnt/sd/retrodeck/saves/Final Fantasy VII (USA).m3u",
          "root_kind": "savefile_directory",
          "needs": [],
          "file_set": {
            "state": "observed",
            "files": [
              "Final Fantasy VII (USA).srm"
